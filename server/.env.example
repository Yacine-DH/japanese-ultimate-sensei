# Copy to .env and adjust. All variables are prefixed SENSEI_.
# Required (≥ 16 chars), the server won't start without it. Generate: openssl rand -hex 24
SENSEI_API_TOKEN=
# Local dev only: run without auth.
# SENSEI_ALLOW_NO_AUTH=true
# Defaults to <repo>/data
# SENSEI_DATA_DIR=/srv/sensei/data
# Extra CORS origins, comma separated JSON list
# SENSEI_CORS_ORIGINS=["http://localhost:5173"]

# LLM for line translations / grammar notes (OpenAI-compatible). Examples:
# SENSEI_LLM_BASE_URL=http://localhost:11434/v1        # Ollama on this server
# SENSEI_LLM_BASE_URL=http://<laptop>.<tailnet>.ts.net:11434/v1   # Ollama on the laptop
# SENSEI_LLM_MODEL=qwen2.5:3b
# SENSEI_LLM_AUTO_TRANSLATE=true   # translate every import in the background (and resume at startup)
# Pick a model: uv run python -m app.llm_bench --models qwen2.5:3b,qwen2.5:7b --jimaku "Sousou no Frieren" --episode 2
# Speech-to-text for anime without Japanese subtitles (OpenAI-compatible /v1/audio/transcriptions),
# e.g. whisper.cpp's whisper-server on the GPU laptop:
# SENSEI_STT_BASE_URL=http://precision:8080/v1
# SENSEI_STT_MODEL=            # only for servers that host several models
# SENSEI_STT_TIMEOUT_S=3600
